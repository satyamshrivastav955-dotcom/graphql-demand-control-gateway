# Copy to `.env` (git-ignored). Every value is optional; see backend/config/settings.yaml for defaults.

# REQUIRED. Protects the management API (events, metrics, config, dry-run analysis, live stream) and is the
# dashboard login. At least 16 characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# docker compose refuses to start without it. Never commit the real value.
SENTINEL_API_TOKEN=

# Optional. Comma-separated client keys (each >= 16 chars). When set, /graphql-proxy requires `X-API-Key: <key>`
# (the management token is also accepted). Leave empty to keep the enforcing endpoint anonymous.
SENTINEL_GATEWAY_KEYS=

# Optional. enforce (default) | shadow: record the real decision but forward everything (report-only rollout).
SENTINEL_ENFORCEMENT=enforce

# Optional. Slack-compatible webhook notified when an operation is blocked. Treat the URL as a secret.
SENTINEL_ALERT_WEBHOOK_URL=

# Where allowed operations are forwarded. Required in proxy mode.
SENTINEL_UPSTREAM_URL=http://localhost:8001/graphql

# proxy (default) | simulation (analyse only; returns a clearly labelled fake response - never for production)
SENTINEL_MODE=proxy

# allow | flag (default; scored as suspicious) | block (hard limit)
SENTINEL_INTROSPECTION=flag

# Comma-separated browser origins allowed to call the API cross-origin.
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite file for audit events.
SENTINEL_DB_PATH=backend/storage/sentinel.db

# Only behind a trusted reverse proxy: read the client IP from X-Forwarded-For.
SENTINEL_TRUST_PROXY_HEADERS=false

# Any setting can be overridden as SENTINEL_<SECTION>__<KEY>, e.g.:
# SENTINEL_LIMITS__MAX_DEPTH=12
# SENTINEL_THROTTLE__RATE_LIMIT=60
# SENTINEL_SECURITY__POLICY__ML_WEIGHT=0.5
